# Copy to .env and adjust. All OffsecHub settings use the OFFSECHUB_ prefix.
POSTGRES_PASSWORD=change-me-to-something-long

# First-run admin. If the password is empty, a random one is printed in the logs once.
OFFSECHUB_ADMIN_EMAIL=admin@offsechub.local
OFFSECHUB_ADMIN_PASSWORD=

# Set to true when served over HTTPS (required in production).
OFFSECHUB_COOKIE_SECURE=false

# Optional overrides
# OFFSECHUB_DATABASE_URL=sqlite:///./data/runtime/offsechub.db
# OFFSECHUB_STORAGE_DIR=./data/runtime/evidence
# OFFSECHUB_SESSION_TTL_HOURS=12
# OFFSECHUB_MAX_UPLOAD_MB=50
# OFFSECHUB_CORS_ORIGINS=["http://localhost:5173"]
